{
  // 프로젝트 tsconfig.json에서 "extends"로 불러요. ${configDir}는 불러온 쪽 tsconfig 위치예요.
  // FE 하네스와 달리 두 옵션을 꺼요.
  // - verbatimModuleSyntax: Nest 기본 출력(CommonJS)에서 import 문법이 에러가 나요.
  // - exactOptionalPropertyTypes: DTO의 선택 필드(string | undefined)를 TypeORM find 옵션에 넘길 때마다 막혀요.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    // Nest DI와 class-validator·TypeORM 데코레이터가 쓰는 메타데이터예요.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": { "@/*": ["${configDir}/src/*"] }
  }
}
